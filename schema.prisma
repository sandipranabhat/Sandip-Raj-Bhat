generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum ContentStatus { DRAFT REVIEW APPROVED SCHEDULED PUBLISHED ARCHIVED }
enum UserRole { SUPER_ADMIN ADMIN EDITOR AUTHOR MEDIA_MANAGER SEO_MANAGER }
model User { id String @id @default(cuid()); name String?; email String @unique; passwordHash String; role UserRole @default(AUTHOR); active Boolean @default(true); failedLogins Int @default(0); lockedUntil DateTime?; lastLoginAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Page { id String @id @default(cuid()); title String; slug String @unique; excerpt String?; content String?; status ContentStatus @default(DRAFT); seoTitle String?; seoDesc String?; canonical String?; noIndex Boolean @default(false); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt; publishedAt DateTime? }
model PageSection { id String @id @default(cuid()); pageId String; type String; order Int @default(0); enabled Boolean @default(true); data Json; page Page @relation(fields:[pageId],references:[id],onDelete:Cascade); @@index([pageId,order]) }
model Post { id String @id @default(cuid()); title String; slug String @unique; excerpt String?; content String; category String?; tags String?; featured Boolean @default(false); status ContentStatus @default(DRAFT); seoTitle String?; seoDesc String?; publishedAt DateTime?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Project { id String @id @default(cuid()); title String; slug String @unique; summary String?; description String?; category String?; technologies String?; coverImage String?; featured Boolean @default(false); status ContentStatus @default(DRAFT); seoTitle String?; seoDesc String?; createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model Expertise { id String @id @default(cuid()); name String; category String?; description String?; icon String?; featured Boolean @default(false); sortOrder Int @default(0) }
model Career { id String @id @default(cuid()); position String; organization String; location String?; startDate DateTime; endDate DateTime?; current Boolean @default(false); description String?; achievements String?; sortOrder Int @default(0) }
model Leadership { id String @id @default(cuid()); title String; organization String?; role String?; date DateTime?; location String?; description String?; impact String?; featured Boolean @default(false) }
model FAQ { id String @id @default(cuid()); question String; answer String; category String?; pageSlug String?; featured Boolean @default(false); sortOrder Int @default(0) }
model Media { id String @id @default(cuid()); url String; filename String; altText String?; caption String?; mimeType String?; size Int?; storageKey String?; createdAt DateTime @default(now()) }
model GalleryAlbum { id String @id @default(cuid()); name String; slug String @unique; description String?; createdAt DateTime @default(now()) }
model GalleryItem { id String @id @default(cuid()); albumId String?; mediaId String; caption String?; sortOrder Int @default(0) }
model ContactInquiry { id String @id @default(cuid()); name String; email String; organization String?; subject String; message String; status String @default("NEW"); createdAt DateTime @default(now()); updatedAt DateTime @updatedAt }
model SiteSetting { id String @id @default(cuid()); key String @unique; value String; updatedAt DateTime @updatedAt }
model SocialLink { id String @id @default(cuid()); platform String; url String; username String?; active Boolean @default(true); sortOrder Int @default(0) }
model Testimonial { id String @id @default(cuid()); person String; organization String?; position String?; testimonial String; photo String?; featured Boolean @default(false); createdAt DateTime @default(now()) }
model Navigation { id String @id @default(cuid()); name String; location String; active Boolean @default(true); items Json }
model Revision { id String @id @default(cuid()); entityType String; entityId String; version Int; snapshot Json; createdBy String; createdAt DateTime @default(now()); @@index([entityType,entityId]) }
model AuditLog { id String @id @default(cuid()); userId String?; action String; entityType String; entityId String?; ip String?; userAgent String?; metadata Json?; createdAt DateTime @default(now()); @@index([createdAt]) }
model Redirect { id String @id @default(cuid()); fromPath String @unique; toPath String; status Int @default(301); createdAt DateTime @default(now()) }
